            </column>
            <column name="[National Latest Adoption]" datatype="real" role="measure" type="quantitative" caption="National Latest Adoption (%)">
              <calculation class="tableau" formula="{ FIXED : SUM([Latest Adoption Product]) } / { FIXED : SUM([Latest Users]) }"/>
            </column>
            <column name="[Monthly Adoption]" datatype="real" role="measure" type="quantitative" caption="Monthly Adoption (%)">
              <calculation class="tableau" formula="{ FIXED [month] : SUM([digital_adoption_pct] * [unique_users]) } / { FIXED [month] : SUM([unique_users]) }"/>
            </column>
            <column name="[Regional Adoption]" datatype="real" role="measure" type="quantitative" caption="Regional Adoption (%)">
              <calculation class="tableau" formula="{ FIXED [region] : SUM([Latest Adoption Product]) } / { FIXED [region] : SUM([Latest Users]) }"/>
            </column>
            <column name="[Gap pp]" datatype="real" role="measure" type="quantitative" caption="Gap (percentage points)">
              <calculation class="tableau" formula="MAX(65 - [Regional Adoption], 0)"/>
            </column>
            <column name="[Target]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="65"/>
            </column>
            <column name="[Target Status]" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [Regional Adoption] &lt; 65 THEN &quot;Below Target&quot; ELSE &quot;On/Above Target&quot; END"/>
            </column>
            <column name="[Funding Priority]" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [region] = &quot;Najran&quot; OR [region] = &quot;Northern Borders&quot; OR [region] = &quot;Al-Baha&quot; OR [region] = &quot;Jazan&quot; THEN &quot;Four widest gaps&quot; ELSE &quot;Other regions&quot; END"/>
            </column>
            <column name="[Allocation SAR M]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="CASE [region] WHEN &quot;Najran&quot; THEN 13.5 WHEN &quot;Northern Borders&quot; THEN 7.5 WHEN &quot;Al-Baha&quot; THEN 7.5 WHEN &quot;Jazan&quot; THEN 6.5 WHEN &quot;Asir&quot; THEN 2.0 WHEN &quot;Tabuk&quot; THEN 1.5 WHEN &quot;Hail&quot; THEN 1.0 WHEN &quot;Al-Jouf&quot; THEN 0.5 ELSE 0 END"/>
            </column>
            <column-instance column="[Gap pp]" derivation="Min" name="[min:Gap pp:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[region]" derivation="None" name="[none:region:nk]" pivot="key" type="nominal"/>
            <column-instance column="[Funding Priority]" derivation="None" name="[none:Funding Priority:nk]" pivot="key" type="nominal"/>
            <column-instance column="[Target Status]" derivation="None" name="[none:Target Status:nk]" pivot="key" type="nominal"/>
          </datasource-dependencies>
          <filter class="categorical" column="[tayseer].[none:Target Status:nk]">
            <groupfilter function="member" level="[tayseer].[none:Target Status:nk]" member="&quot;Below Target&quot;"/>
          </filter>
          <computed-sort column="[tayseer].[none:region:nk]" direction="DESC" using="[tayseer].[min:Gap pp:qk]"/>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="axis">
            <encoding attr="space" class="0" field="[tayseer].[min:Gap pp:qk]" field-type="quantitative" max="5" min="0" range-type="fixed" type="space"/>
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <encodings>
              <text column="[tayseer].[min:Gap pp:qk]"/>
              <color column="[tayseer].[none:Funding Priority:nk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true"/>
                <format attr="mark-labels-cull" value="true"/>
                <format attr="color" value="#087D82"/>
                <encoding attr="color" field="[tayseer].[none:Funding Priority:nk]" type="palette">
                  <map to="#087E87">
                    <bucket>"Four widest gaps"</bucket>
                  </map>
                  <map to="#D8E6E7">
                    <bucket>"Other regions"</bucket>
                  </map>
                </encoding>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[tayseer].[none:region:nk]</rows>
        <cols>[tayseer].[min:Gap pp:qk]</cols>
      </table>
      <simple-id uuid="{AFA4805E-3827-4607-8BB8-1E17D71BD32D}"/>
    </worksheet>
  </worksheets>
