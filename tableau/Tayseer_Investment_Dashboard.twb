            <column name="[Latest Adoption Product]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [month] = [Latest Month] THEN [digital_adoption_pct] * [unique_users] END"/>
            </column>
            <column name="[Latest Users]" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [month] = [Latest Month] THEN [unique_users] END"/>
            </column>
            <column name="[National Latest Adoption]" datatype="real" role="measure" type="quantitative" caption="National Latest Adoption (%)">
              <calculation class="tableau" formula="{ FIXED : SUM([Latest Adoption Product]) } / { FIXED : SUM([Latest Users]) }"/>
            </column>
            <column name="[Monthly Adoption]" datatype="real" role="measure" type="quantitative" caption="Monthly Adoption (%)">
              <calculation class="tableau" formula="{ FIXED [month] : SUM([digital_adoption_pct] * [unique_users]) } / { FIXED [month] : SUM([unique_users]) }"/>
            </column>
