            </column>
            <column name="[Gap pp]" datatype="real" role="measure" type="quantitative" caption="Gap (percentage points)">
              <calculation class="tableau" formula="MAX(65 - [Regional Adoption], 0)"/>
            </column>
            <column name="[Target]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="65"/>
            </column>
            <column name="[Target Status]" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [Regional Adoption] &lt; 65 THEN &quot;Below Target&quot; ELSE &quot;On/Above Target&quot; END"/>
            </column>
            <column name="[Funding Priority]" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [region] = &quot;Najran&quot; OR [region] = &quot;Northern Borders&quot; OR [region] = &quot;Al-Baha&quot; OR [region] = &quot;Jazan&quot; THEN &quot;Four widest gaps&quot; ELSE &quot;Other regions&quot; END"/>
            </column>
            <column name="[Allocation SAR M]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="CASE [region] WHEN &quot;Najran&quot; THEN 13.5 WHEN &quot;Northern Borders&quot; THEN 7.5 WHEN &quot;Al-Baha&quot; THEN 7.5 WHEN &quot;Jazan&quot; THEN 6.5 WHEN &quot;Asir&quot; THEN 2.0 WHEN &quot;Tabuk&quot; THEN 1.5 WHEN &quot;Hail&quot; THEN 1.0 WHEN &quot;Al-Jouf&quot; THEN 0.5 ELSE 0 END"/>
            </column>
            <column-instance column="[National Latest Adoption]" derivation="Min" name="[min:National Latest Adoption:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
        <style/>
        <panes>
          <pane>
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Text"/>
            <encodings>
              <text column="[tayseer].[min:National Latest Adoption:qk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true"/>
                <format attr="mark-labels-cull" value="true"/>
                <format attr="color" value="#087D82"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows/>
        <cols/>
      </table>
      <simple-id uuid="{8CF5B8F6-305F-4B34-BCD8-350FA821C5E1}"/>
    </worksheet>
