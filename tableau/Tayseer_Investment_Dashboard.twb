<?xml version='1.0' encoding='UTF-8'?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" original-version="26.1" source-build="0.0.0 (0000.0.0.0)" source-platform="win" version="26.1">
  <document-format-change-manifest>
    <ManifestByVersion/>
  </document-format-change-manifest>
  <preferences>
    <preference name="ui.encoding.shelf.height" value="24"/>
  </preferences>
  <datasources>
    <datasource name="tayseer" caption="Tayseer synthetic training data" inline="true" version="26.1">
      <connection class="textscan" directory="Data" filename="tayseer_services_synthetic.csv" password="" server="">
        <relation name="tayseer_services_synthetic" table="[tayseer_services_synthetic.csv]" type="table">
          <columns header="yes" separator="," locale="en_US">
            <column name="month" datatype="date" ordinal="0"/>
            <column name="region" datatype="string" ordinal="1"/>
            <column name="service_category" datatype="string" ordinal="2"/>
            <column name="channel" datatype="string" ordinal="3"/>
            <column name="transactions" datatype="integer" ordinal="4"/>
            <column name="unique_users" datatype="integer" ordinal="5"/>
            <column name="digital_adoption_pct" datatype="real" ordinal="6"/>
            <column name="csat" datatype="real" ordinal="7"/>
            <column name="avg_completion_min" datatype="real" ordinal="8"/>
            <column name="first_time_resolution_pct" datatype="real" ordinal="9"/>
            <column name="cost_per_txn_sar" datatype="real" ordinal="10"/>
            <column name="sla_breach_pct" datatype="real" ordinal="11"/>
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes"/>
      <column name="[month]" datatype="date" role="dimension" type="ordinal"/>
      <column name="[region]" datatype="string" role="dimension" type="nominal"/>
      <column name="[service_category]" datatype="string" role="dimension" type="nominal"/>
      <column name="[channel]" datatype="string" role="dimension" type="nominal"/>
      <column name="[transactions]" datatype="integer" role="measure" type="quantitative"/>
      <column name="[unique_users]" datatype="integer" role="measure" type="quantitative"/>
      <column name="[digital_adoption_pct]" datatype="real" role="measure" type="quantitative"/>
      <column name="[csat]" datatype="real" role="measure" type="quantitative"/>
      <column name="[avg_completion_min]" datatype="real" role="measure" type="quantitative"/>
      <column name="[first_time_resolution_pct]" datatype="real" role="measure" type="quantitative"/>
      <column name="[cost_per_txn_sar]" datatype="real" role="measure" type="quantitative"/>
      <column name="[sla_breach_pct]" datatype="real" role="measure" type="quantitative"/>
      <column name="[Latest Month]" datatype="date" role="dimension" type="ordinal">
        <calculation class="tableau" formula="{ FIXED : MAX([month]) }"/>
      </column>
      <column name="[Latest Adoption]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [month] = [Latest Month] THEN [digital_adoption_pct] END"/>
      </column>
      <column name="[Latest Transactions]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [month] = [Latest Month] THEN [transactions] END"/>
      </column>
      <column name="[Regional Adoption]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [region] : AVG([Latest Adoption]) }"/>
      </column>
      <column name="[Regional Transactions]" datatype="integer" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [region] : SUM([Latest Transactions]) }"/>
      </column>
      <column name="[Gap pp]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(65 - [Regional Adoption], 0)"/>
      </column>
      <column name="[Priority Index]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Gap pp] / 100 * [Regional Transactions]"/>
      </column>
      <column name="[Target]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="65"/>
      </column>
      <column name="[Pilot Region]" datatype="string" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [region] = &quot;Najran&quot; OR [region] = &quot;Jazan&quot; OR [region] = &quot;Northern Borders&quot; THEN &quot;Pilot&quot; ELSE &quot;Other&quot; END"/>
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Latest national course index">
      <table>
        <view>
          <datasources>
            <datasource name="tayseer" caption="Tayseer synthetic training data"/>
          </datasources>
          <datasource-dependencies datasource="tayseer">
            <column name="[month]" datatype="date" role="dimension" type="ordinal"/>
            <column name="[region]" datatype="string" role="dimension" type="nominal"/>
            <column name="[service_category]" datatype="string" role="dimension" type="nominal"/>
            <column name="[channel]" datatype="string" role="dimension" type="nominal"/>
            <column name="[transactions]" datatype="integer" role="measure" type="quantitative"/>
            <column name="[unique_users]" datatype="integer" role="measure" type="quantitative"/>
            <column name="[digital_adoption_pct]" datatype="real" role="measure" type="quantitative"/>
            <column name="[csat]" datatype="real" role="measure" type="quantitative"/>
            <column name="[avg_completion_min]" datatype="real" role="measure" type="quantitative"/>
            <column name="[first_time_resolution_pct]" datatype="real" role="measure" type="quantitative"/>
            <column name="[cost_per_txn_sar]" datatype="real" role="measure" type="quantitative"/>
            <column name="[sla_breach_pct]" datatype="real" role="measure" type="quantitative"/>
            <column name="[Latest Month]" datatype="date" role="dimension" type="ordinal">
              <calculation class="tableau" formula="{ FIXED : MAX([month]) }"/>
            </column>
            <column name="[Latest Adoption]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [month] = [Latest Month] THEN [digital_adoption_pct] END"/>
            </column>
            <column name="[Latest Transactions]" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [month] = [Latest Month] THEN [transactions] END"/>
            </column>
            <column name="[Regional Adoption]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="{ FIXED [region] : AVG([Latest Adoption]) }"/>
            </column>
            <column name="[Regional Transactions]" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="{ FIXED [region] : SUM([Latest Transactions]) }"/>
            </column>
            <column name="[Gap pp]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="MAX(65 - [Regional Adoption], 0)"/>
            </column>
            <column name="[Priority Index]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="[Gap pp] / 100 * [Regional Transactions]"/>
            </column>
            <column name="[Target]" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="65"/>
            </column>
            <column name="[Pilot Region]" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [region] = &quot;Najran&quot; OR [region] = &quot;Jazan&quot; OR [region] = &quot;Northern Borders&quot; THEN &quot;Pilot&quot; ELSE &quot;Other&quot; END"/>
            </column>
            <column-instance column="[Latest Adoption]" derivation="Avg" name="[avg:Latest Adoption:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
        <style/>
        <panes>
          <pane>
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Text"/>
            <encodings>
              <text column="[tayseer].[avg:Latest Adoption:qk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true"/>
                <format attr="mark-labels-cull" value="true"/>
                <format attr="color" value="#087D82"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows/>
        <cols/>
      </table>
      <simple-id uuid="{0C06538E-66C3-4A26-98AF-76CA69E6736D}"/>
    </worksheet>
