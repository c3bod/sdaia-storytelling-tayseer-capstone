  <dashboards>
    <dashboard name="Tayseer investment decision">
      <style/>
      <size maxheight="900" maxwidth="1400" minheight="900" minwidth="1400"/>
      <zones is-pixels="true">
        <zone id="1" x="20" y="10" w="1360" h="60" type-v2="text">
          <formatted-text>
            <run fontname="Arial" fontsize="22" bold="true">Tayseer: phased SAR 40M investment toward 65% adoption</run>
          </formatted-text>
        </zone>
        <zone id="2" x="20" y="90" w="300" h="180" name="Latest national course index" show-title="true"/>
        <zone id="3" x="340" y="90" w="1040" h="260" name="National monthly adoption toward 65%" show-title="true"/>
        <zone id="4" x="20" y="365" w="680" h="455" name="Regional adoption December 2025" show-title="true"/>
        <zone id="5" x="720" y="365" w="660" h="350" name="Gap and volume priority December 2025" show-title="true"/>
        <zone id="6" x="720" y="730" w="660" h="90" type-v2="text">
          <formatted-text>
            <run fontname="Arial" fontsize="14" bold="true">Proposed SAR M: Najran 13; Jazan 11; Northern Borders 11; reserve 5. Release only 10M initially; review at day 90.</run>
          </formatted-text>
        </zone>
        <zone id="7" x="20" y="835" w="1360" h="55" type-v2="text">
          <formatted-text>
            <run fontname="Arial" fontsize="12" bold="true">Synthetic training data. Arithmetic-mean course index. Priority = gap x transactions (proxy). Transaction weighting selects Al-Baha instead of Jazan. Agree the metric before scaling.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid="{D2AD21A6-8207-4CC1-9B76-71C7833B9215}"/>
    </dashboard>
  </dashboards>
  <thumbnails/>
  <explain-data enabled-for-viewer="false" extreme-values-enabled-for-all="false">
    <explanation-types/>
  </explain-data>
</workbook>
